{
  "name": "ts-bp",
  "version": "0.1.0",
  "description": "backend ",
  "main": "dist/server.js",
  "_moduleAliases": {
    "@api": "dist/api",
    "@cache": "dist/cache",
    "@config": "dist/config",
    "@core": "dist/core",
    "@database": "dist/database",
    "@docs": "dist/docs",
    "@middleware": "dist/middleware",
    "@service": "dist/service",
    "@type": "dist/type",
    "@util": "dist/util"
  },
  "scripts": {
    "lint:fix": "eslint . --ext .ts --fix",
    "lint": "eslint . --ext .ts",
    "start": "npm run build-ts && npm run serve",
    "build": "npm run lint && npm run build-ts",
    "serve": "node dist/server.js",
    "watch-node": "nodemon dist/server.js",
    "watch": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run watch-node\"",
    "test": "jest --detectOpenHandles --forceExit --verbose --runInBand --coverage",
    "watch-test": "npm run test -- --watchAll",
    "build-ts": "tsc",
    "watch-ts": "tsc -w",
    "debug": "npm run build && npm run watch-debug",
    "serve-debug": "nodemon dist/server.js",
    "watch-debug": "concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run serve-debug\"",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migrate": "typeorm migration:run",
    "migrate:run": "node_modules/.bin/typeorm migration:run",
    "prettier": "prettier --config --ignore-path .gitignore .prettierrc './**.ts' --check",
    "prettier:fix": "prettier --config --ignore-path .gitignore .prettierrc './**.ts' --write",
    "prepare": "husky install"
  },
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "@sentry/node": "^5.29.2",
    "@types/bcrypt": "^3.0.0",
    "@types/cors": "^2.8.9",
    "@types/hapi__joi": "^17.1.6",
    "@types/http-errors": "^1.8.0",
    "@types/jsonwebtoken": "^8.5.0",
    "aws-sdk": "^2.818.0",
    "axios": "^0.21.1",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.19.0",
    "concurrently": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "express-handlebars": "^5.2.0",
    "express-http-context": "^1.2.4",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.2.0",
    "http-errors": "^1.8.0",
    "i18n": "^0.13.2",
    "jsonwebtoken": "^9.0.0",
    "module-alias": "^2.2.2",
    "moment-timezone": "^0.5.33",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "openapi-types": "^12.1.0",
    "pg": "^8.10.0",
    "swagger-jsdoc": "^6.0.6",
    "swagger-ui-express": "^4.1.5",
    "typedi": "^0.10.0",
    "typeorm": "^0.2.29",
    "typeorm-naming-strategies": "^2.0.0",
    "typeorm-pagination": "^2.0.1",
    "uuid": "^8.3.2",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.5.1",
    "@commitlint/config-conventional": "^17.4.4",
    "@types/body-parser": "^1.19.0",
    "@types/concurrently": "^5.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/eslint": "^7.2.6",
    "@types/express": "^4.17.9",
    "@types/express-handlebars": "^3.1.0",
    "@types/i18n": "^0.12.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^14.14.14",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^3.0.2",
    "@types/swagger-ui-express": "^4.1.2",
    "@types/uuid": "^8.3.0",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^5.27.0",
    "@typescript-eslint/parser": "^5.27.0",
    "commitlint-plugin-function-rules": "^1.3.2",
    "eslint": "^8.16.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^7.0.1",
    "jest": "^29.7.0",
    "nodemon": "^2.0.6",
    "npx": "^3.0.0",
    "prettier": "^2.7.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^4.1.3",
    "validate-branch-name": "^1.3.0"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run build",
      "pre-commit": "npm run prettier && npm run lint"
    }
  },
  "validate-branch-name": {
    "pattern": "^(feature|fix|hotfix|release)/[A-Z]{1,}-[0-9]{1,}",
    "errorMsg": "Please follow the standard branching convention, eg: feature/SG-1"
  },
  "engines": {
    "node": ">=18.15.0"
  }
}
